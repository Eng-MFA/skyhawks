# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# ضع هنا الـ Connection String من Atlas بالظبط
# Atlas Dashboard → Clusters → Connect → Drivers → Copy the string
# استبدل <password> بكلمة السر الحقيقية (بدون < >)
#
# مثال:
# MONGODB_URI=mongodb+srv://skyhawks:MyActualPassword123@skyhawks.1zp7icb.mongodb.net/skyhawks?retryWrites=true&w=majority&appName=skyhawks
#
MONGODB_URI=mongodb+srv://skyhawks:skyhawks2025@skyhawks.1zp7icb.mongodb.net/skyhawks?retryWrites=true&w=majority&appName=skyhawks

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=skyhawks_super_secret_jwt_key_2026

# ─── Admin Credentials ────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=skyhawks2026

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
# هذا السطر يجبر السيرفر يشتغل على local حتى لو NODE_ENV=production
LOCAL_SERVER=true

# ─── Frontend URL (للـ CORS) ──────────────────────────────────────────────────
FRONTEND_URL=https://skyhawks.vercel.app
